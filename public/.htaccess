Options -Indexes -MultiViews
RewriteEngine On

# Canonical clean URL redirects
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Specific directory collisions resolved first
RewriteRule ^pages/blog/?$ pages/blog.html [L]
RewriteRule ^pages/services/?$ pages/services.html [L]

# Redirects for consolidated duplicate blog posts (old URL -> canonical resource page)
# Must precede the generic clean-URL rule below, since the old .html files still exist on disk.
RewriteRule ^pages/blog/page-1-google-2026/?$ /on-page-seo [R=301,L]
RewriteRule ^pages/blog/local-seo-small-business-usa-2026/?$ /local-seo [R=301,L]
RewriteRule ^pages/blog/website-loading-speed-fix/?$ /technical-seo [R=301,L]
RewriteRule ^pages/blog/ai-website-builder-vs-web-agency-2026/?$ /website-redesigns [R=301,L]
RewriteRule ^pages/blog/saas-vs-custom-website/?$ /saas-vs-custom-website [R=301,L]
RewriteRule ^pages/blog/choose-software-development-agency-2026/?$ /software-development-tools [R=301,L]
RewriteRule ^pages/blog/website-cost-small-business-2026/?$ /website-cost-guide [R=301,L]
RewriteRule ^pages/blog/best-ai-tools-small-business-usa-2026/?$ /best-ai-tools [R=301,L]

# Clean URLs: Rewrite extensionless URLs to their .html files dynamically
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
RewriteRule ^api/send-lead/?$ api/send-lead.php [L]
RewriteRule ^api/send-contact/?$ api/send-contact.php [L]

RewriteRule ^website-design-usa/?$ pages/website-design-usa.html [L]
RewriteRule ^website-design-canada/?$ pages/website-design-canada.html [L]
RewriteRule ^web-development-new-york/?$ pages/web-development-new-york.html [L]

